# ─── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=000000000:PLACEHOLDER_TOKEN_REPLACE_ME
# Владельцы бота (через запятую). Могут всё, включая управление другими админами.
ADMIN_IDS=123456789,987654321
# Контакт поддержки, показывается в /help, /paysupport и при бане (можно менять из админки).
SUPPORT_CONTACT=@your_support

# ─── Веб-сервер, антитвинк и вебхук PiarFlow ──────────────────────────────────
# HTTPS-адрес контейнера из панели (RubyHost: «Веб-адрес (HTTPS)»). Без него проверка
# устройства выключена. Порт берётся из SERVER_PORT, который панель задаёт сама.
WEB_PUBLIC_URL=
# SERVER_PORT=8080
# Вебхук отписок PiarFlow: {WEB_PUBLIC_URL}/api/piarflow/webhook
# Все флаги ниже можно менять из админки (Настройки → Антитвинк) без перезапуска.
DEVICE_CHECK_ENABLED=true          # кнопка «Подтвердить устройство» и гейт рефералки
DEVICE_CHECK_FOR_OP=true           # задания ОП только после проверки устройства
DEVICE_CHECK_FOR_WITHDRAW=true     # вывод только после проверки устройства
TWINK_BLOCK_REFERRAL=true          # не платить бонус за реферала с уже известного устройства
TWINK_BLOCK_OP=true                # не выдавать ОП твинкам (качество трафика PiarFlow)
TWINK_BLOCK_WITHDRAW=false         # запрещать вывод твинкам (иначе — только предупреждение админу)
TWINK_REQUIRE_IP_MATCH=false       # считать твинком только при совпадении отпечатка И IP
TWINK_IP_WINDOW_DAYS=30

# ─── База данных ─────────────────────────────────────────────────────────────
# SQLite (по умолчанию, WAL включается автоматически):
DATABASE_URL=sqlite+aiosqlite:///./data/kodostars.db
# Postgres (pip install asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/kodostars
# Миграции Alembic применяются автоматически при старте.

# ─── Экономика (всё ниже можно переопределить в рантайме: Админка → Настройки) ──
REFERRAL_LEVELS=2
REFERRAL_L1_PERCENT=15
REFERRAL_L2_PERCENT=5
REFERRAL_L1_BONUS=10
REFERRAL_L2_BONUS=3
MIN_REFERRAL_ACTIVITY=2
# Мин. число оплаченных подписок PiarFlow (status=subscribed) у реферала до бонуса.
REFERRAL_MIN_PIARFLOW_SUBS=2
NOTIFY_REFERRER=true
DAILY_BASE_REWARD=5
DAILY_STREAK_BONUS=1
DAILY_STREAK_CAP=7
SIGNUP_BONUS=5
CLAIM_COOLDOWN_SECONDS=3

# Премиум-эмодзи внутренней валюты (баланс, награды). Можно менять из Админка → Настройки.
# CURRENCY_EMOJI_ID — numeric id или кусок <tg-emoji emoji-id="…">…</tg-emoji>
# CURRENCY_EMOJI_FALLBACK — unicode, если клиент не рисует custom emoji
CURRENCY_EMOJI_ID=5904462880941545555
CURRENCY_EMOJI_FALLBACK=⭐

# Вывод: минимум/максимум (0 = без лимита), кулдаун между заявками, мин. активных рефералов.
# Выплата Stars — через Fragment (нужен @username у пользователя).
WITHDRAW_ENABLED=true
WITHDRAW_MIN=50
WITHDRAW_MAX=0
WITHDRAW_COOLDOWN_HOURS=24
WITHDRAW_MIN_REFERRALS=0
# Канал-лог завершённых выплат (chat_id, напр. -100…). 0 = выкл. Бот — админ канала.
# Можно менять в Админка → Настройки → Вывод.
PAYOUT_LOG_CHAT_ID=0

# Режим обслуживания (не-админы видят MAINTENANCE_TEXT).
MAINTENANCE_MODE=false
MAINTENANCE_TEXT=Бот на техническом обслуживании. Загляните чуть позже.

# ─── Рассылки и антиспам ─────────────────────────────────────────────────────
BROADCAST_RATE_PER_SEC=20
THROTTLE_SECONDS=0.4

# ─── ОП: PiarFlow (если антитвинк OK) + Tgrass (всегда / только без проверки) ─
# Tgrass: https://tgrass.space/integration  заголовок Auth (без Bearer).
# PiarFlow: https://piarflow.com/api-docs  Authorization: Bearer.
# Verified → PiarFlow затем Tgrass; без проверки устройства → только Tgrass.
OP_TIMEOUT_SEC=8
OP_CACHE_SEC=180

TGRASS_ENABLED=true
TGRASS_API_KEY=
TGRASS_API_URL=https://tgrass.space
TGRASS_MAX_SPONSORS=5
# Штраф за отписку (вебхук /api/tgrass/unsubscribe). Меняется в админке.
TGRASS_UNSUB_PENALTY=10

PIARFLOW_ENABLED=true
PIARFLOW_API_KEY=
PIARFLOW_API_URL=https://piarflow.com/v1
PIARFLOW_MAX_SPONSORS=5
# Сколько внутренних Stars списывать с баланса за каждую отписку (вебхук).
PIARFLOW_UNSUB_PENALTY=10

# ─── BotoHub Views (показы рекламы, не ОП) ───────────────────────────────────
# https://views.botohub.me/integration — токен из @botohub_views_bot → Интеграция.
# Можно менять в Админка → Настройки (runtime).
BOTOHUB_VIEWS_ENABLED=false
BOTOHUB_VIEWS_TOKEN=
BOTOHUB_VIEWS_COOLDOWN_SECONDS=60
# BOTOHUB_VIEWS_API_URL=https://views.botohub.me/ad/SendPost

# ─── Fragment (выплата Stars) ────────────────────────────────────────────────
# 24-word TON wallet mnemonic used to pay Fragment purchases.
# Keep it ONLY in server .env. Never send it to the bot/admin chat.
FRAGMENT_WALLET_MNEMONIC=
# Header-string cookies after login on fragment.com + same wallet connected:
# stel_ssid=...; stel_token=...; stel_ton_token=...; stel_dt=...
FRAGMENT_COOKIES=
# Optional. Without it the bot uses public Toncenter (как в типичных ботах
# только с mnemonic+cookies). С ключом — надёжнее: https://tonconsole.com/
# FRAGMENT_TONAPI_KEY=
# V4R2 or V5R1 (must match the wallet connected on Fragment).
FRAGMENT_WALLET_VERSION=V5R1
FRAGMENT_SHOW_SENDER=false

# ─── Логи ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
