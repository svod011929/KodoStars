# Telegram
BOT_TOKEN=000000000:PLACEHOLDER_TOKEN_REPLACE_ME
ADMIN_IDS=123456789,987654321

# Database (SQLite MVP; swap to Postgres when ready)
# SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/kodostars.db
# Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/kodostars

# Economy
REFERRAL_LEVELS=2
REFERRAL_L1_PERCENT=15
REFERRAL_L2_PERCENT=5
REFERRAL_L1_BONUS=10
REFERRAL_L2_BONUS=3
MIN_REFERRAL_ACTIVITY=2
DAILY_BASE_REWARD=5
DAILY_STREAK_BONUS=1
DAILY_STREAK_CAP=7
WITHDRAW_MIN=50
WITHDRAW_COOLDOWN_HOURS=24
SIGNUP_BONUS=5
CLAIM_COOLDOWN_SECONDS=3

# OP cascade (Flyer → SubGram → BotoHub → PiarFlow → TGrass → manual)
OP_TIMEOUT_SEC=8
OP_CACHE_SEC=180

FLYER_ENABLED=true
FLYER_API_KEY=
FLYER_API_URL=https://api.flyerservice.io

SUBGRAM_ENABLED=true
SUBGRAM_API_KEY=
SUBGRAM_API_URL=https://api.subgram.ru

BOTOHUB_ENABLED=true
BOTOHUB_API_KEY=
BOTOHUB_API_URL=https://botohub.me/api/v1
BOTOHUB_BOT_ID=

PIARFLOW_ENABLED=true
PIARFLOW_API_KEY=
PIARFLOW_API_URL=https://piarflow.com/v1
PIARFLOW_MAX_SPONSORS=5

TGRASS_ENABLED=true
TGRASS_API_KEY=
TGRASS_API_URL=https://api.tgrass.online/v1
TGRASS_CHANNELS=

MANUAL_ENABLED=true
MANUAL_OP_CHANNELS=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
