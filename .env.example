# ─── Telegram ────────────────────────────────────────────────────────────────
BOT_TOKEN=000000000:PLACEHOLDER_TOKEN_REPLACE_ME
# Владельцы бота (через запятую). Могут всё, включая управление другими админами.
ADMIN_IDS=123456789,987654321
# Контакт поддержки, показывается в /help, /paysupport и при бане (можно менять из админки).
SUPPORT_CONTACT=@your_support

# ─── Веб-сервер и антитвинк (Telegram Mini App) ───────────────────────────────
# HTTPS-адрес контейнера из панели (RubyHost: «Веб-адрес (HTTPS)»). Без него проверка
# устройства выключена. Порт берётся из SERVER_PORT, который панель задаёт сама.
WEB_PUBLIC_URL=
# SERVER_PORT=8080
# Все флаги ниже можно менять из админки (Настройки → Антитвинк) без перезапуска.
DEVICE_CHECK_ENABLED=true          # кнопка «Подтвердить устройство» и гейт рефералки
DEVICE_CHECK_FOR_WITHDRAW=true     # вывод только после проверки устройства
TWINK_BLOCK_REFERRAL=true          # не платить бонус за реферала с уже известного устройства
TWINK_BLOCK_WITHDRAW=false         # запрещать вывод твинкам (иначе — только предупреждение админу)
TWINK_REQUIRE_IP_MATCH=false       # считать твинком только при совпадении отпечатка И IP
TWINK_IP_WINDOW_DAYS=30

# ─── База данных ─────────────────────────────────────────────────────────────
# SQLite (по умолчанию, WAL включается автоматически):
DATABASE_URL=sqlite+aiosqlite:///./data/kodostars.db
# Postgres (pip install asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/kodostars
# Миграции Alembic применяются автоматически при старте.

# ─── Экономика (всё ниже можно переопределить в рантайме: Админка → Настройки) ──
REFERRAL_LEVELS=2
REFERRAL_L1_PERCENT=15
REFERRAL_L2_PERCENT=5
REFERRAL_L1_BONUS=10
REFERRAL_L2_BONUS=3
MIN_REFERRAL_ACTIVITY=2
NOTIFY_REFERRER=true
DAILY_BASE_REWARD=5
DAILY_STREAK_BONUS=1
DAILY_STREAK_CAP=7
SIGNUP_BONUS=5
CLAIM_COOLDOWN_SECONDS=3

# Вывод: минимум/максимум (0 = без лимита), кулдаун между заявками, мин. активных рефералов.
WITHDRAW_ENABLED=true
WITHDRAW_MIN=50
WITHDRAW_MAX=0
WITHDRAW_COOLDOWN_HOURS=24
WITHDRAW_MIN_REFERRALS=0

# Режим обслуживания (не-админы видят MAINTENANCE_TEXT).
MAINTENANCE_MODE=false
MAINTENANCE_TEXT=Бот на техническом обслуживании. Загляните чуть позже.

# ─── Рассылки и антиспам ─────────────────────────────────────────────────────
# Сообщений в секунду (лимит Telegram ~30; 20 — безопасно).
BROADCAST_RATE_PER_SEC=20
# Минимальный интервал между действиями одного пользователя, сек (0 = выкл).
THROTTLE_SECONDS=0.4

# ─── Каскад ОП: Flyer → SubGram → BotoHub → PiarFlow → TGrass → Trafsly → manual ──
# Провайдер без ключа пропускается, ошибка API не блокирует пользователей (fail-open).
OP_TIMEOUT_SEC=8
OP_CACHE_SEC=180

# Flyer — https://api.flyerhubs.com/  Ключ бота FL-… из @FlyerServiceBot.
# Тип ключа (sub / tasks) определяется автоматически через /get_me.
FLYER_ENABLED=true
FLYER_API_KEY=
FLYER_API_URL=https://api.flyerhubs.com
FLYER_TASKS_LIMIT=5

SUBGRAM_ENABLED=true
SUBGRAM_API_KEY=
SUBGRAM_API_URL=https://api.subgram.ru

# BotoHub — https://botohub.me/integration  Токен из @botohub, заголовок Auth.
# BOTOHUB_MAX_OP=0 — брать «Макс. спонсоров» из настроек бота в BotoHub.
BOTOHUB_ENABLED=true
BOTOHUB_API_KEY=
BOTOHUB_API_URL=https://botohub.me
BOTOHUB_MAX_OP=0

# PiarFlow — https://piarflow.com/api-docs  API key трафик-бота, Authorization: Bearer.
PIARFLOW_ENABLED=true
PIARFLOW_API_KEY=
PIARFLOW_API_URL=https://piarflow.com/v1
PIARFLOW_MAX_SPONSORS=5

# TGrass — https://tgrass.space/integration  API-ключ из @tgrassbot, заголовок Auth.
# TGRASS_OFFERS_LIMIT=0 — лимит из настроек бота. TGRASS_CHANNELS — свои каналы (getChatMember).
TGRASS_ENABLED=true
TGRASS_API_KEY=
TGRASS_API_URL=https://tgrass.space
TGRASS_OFFERS_LIMIT=0
TGRASS_CHANNELS=

# Trafsly — https://trafsly.com/api-docs  Токен at_… из @TrafslyBot → Мои боты, заголовок Auth.
TRAFSLY_ENABLED=true
TRAFSLY_API_KEY=
TRAFSLY_API_URL=https://api.trafsly.com
TRAFSLY_MAX_SPONSORS=5

# Свои каналы для проверки подписки, через запятую. Форматы записи:
#   @channel                                   публичный канал
#   @channel|Название                          публичный канал с подписью кнопки
#   -1001234567890|https://t.me/+ссылка|Название   приватный или ПЛАТНЫЙ канал:
#   проверка по ID (бот — админ канала), кнопка ведёт на пригласительную/платную ссылку.
# Удобнее добавлять из админки (Каналы ОП): перешлите пост из канала — бот определит ID сам
# и умеет создавать платную ссылку («auto 50» = 50 ⭐/мес).
MANUAL_ENABLED=true
MANUAL_OP_CHANNELS=

# ─── Логи ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
